          "details": [
            "Explain how you finish a workday.",
            "At the end of the day, I + verb",
            "At the end of the day, I check my progress.",
            "At the end of the day, I plan tomorrow's work."
          ],
          "saveKey": "chunk-v1-used-5"
        }
      ]
