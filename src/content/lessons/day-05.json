    {
      "id": "chunks",
      "className": "panel",
      "type": "chunks",
      "label": "CHUNKS · 5 MIN",
      "heading": "Five chunks to use today",
      "instruction": "Learn the whole phrase. Change the details to fit your work. Mở từng thẻ khi cần; sau đó nhìn đi chỗ khác và nói lại.",
      "items": [
        {
          "label": "1/5 · Luyện hôm nay",
          "phrase": "Yesterday, I finished…",
          "meaning": "Hôm qua tôi đã hoàn thành…",
          "details": [
            "Report a task you finished yesterday.",
            "Yesterday, I finished + noun / verb-ing",
            "Yesterday, I finished the report.",
            "Yesterday, I finished testing the login page."
          ],
          "saveKey": "chunk-v1-used-1"
        },
        {
          "label": "2/5 · Luyện hôm nay",
          "phrase": "Today, I'm going to…",
          "meaning": "Hôm nay tôi sẽ…",
          "details": [
            "State your plan for today.",
            "Today, I'm going to + base verb",
            "Today, I'm going to test the app.",
            "Today, I'm going to connect the page to the server."
          ],
          "saveKey": "chunk-v1-used-2"
        },
        {
          "label": "3/5 · Luyện hôm nay",
          "phrase": "I'm still working on…",
          "meaning": "Tôi vẫn đang làm…",
          "details": [
            "Explain which task is not finished yet.",
            "I'm still working on + noun",
            "I'm still working on the report.",
            "I'm still working on the mobile version."
          ],
          "saveKey": "chunk-v1-used-3"
        },
        {
          "label": "4/5 · Luyện hôm nay",
          "phrase": "One blocker is…",
          "meaning": "Một trở ngại là…",
          "details": [
            "Name something that is stopping your progress.",
            "One blocker is + noun / that + clause",
            "One blocker is the missing file.",
            "One blocker is that I don't have the test account."
          ],
          "saveKey": "chunk-v1-used-4"
        },
        {
          "label": "5/5 · Luyện hôm nay",
          "phrase": "I need… from…",
          "meaning": "Tôi cần… từ…",
          "details": [
            "Tell a colleague what you need and from whom.",
            "I need + thing + from + person / team",
            "I need help from my team.",
            "I need the API documentation from the other team."
          ],
          "saveKey": "chunk-v1-used-5"
        }
      ]
    },
